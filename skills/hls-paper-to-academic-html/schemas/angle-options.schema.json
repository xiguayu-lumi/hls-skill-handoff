{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "options", "recommended_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "paper_id": {"type": "string", "minLength": 1},
    "recommended_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "reader_question", "thesis", "evidence_ids",
          "evidence_strength", "reader_value", "clarity", "novelty",
          "visual_potential", "risk_notes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "title": {"type": "string"},
          "reader_question": {"type": "string"},
          "thesis": {"type": "string"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^E[0-9]{3}$"}
          },
          "evidence_strength": {"type": "integer", "minimum": 1, "maximum": 5},
          "reader_value": {"type": "integer", "minimum": 1, "maximum": 5},
          "clarity": {"type": "integer", "minimum": 1, "maximum": 5},
          "novelty": {"type": "integer", "minimum": 1, "maximum": 5},
          "visual_potential": {"type": "integer", "minimum": 1, "maximum": 5},
          "risk_notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
