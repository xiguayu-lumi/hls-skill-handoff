{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "paper_id", "evidence_ids", "slides"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E[0-9]{3}$"}
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "page_type", "title", "lead", "content_blocks",
          "visual", "evidence_ids", "source_label"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "page_type": {"$ref": "#/$defs/page_type"},
          "title": {"type": "string", "minLength": 1},
          "lead": {"type": "string"},
          "content_blocks": {"type": "array"},
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "data"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "data": {"type": "object"}
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^E[0-9]{3}$"}
          },
          "source_label": {"type": "string"},
          "section": {
            "type": ["object", "null"],
            "properties": {
              "zh": {"type": "string"},
              "en": {"type": "string"},
              "number": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "page_type": {
      "enum": [
        "cover", "paper_identity", "abstract_brief", "agenda", "section",
        "problem", "concept", "comparison", "method", "sample", "process",
        "finding", "metrics", "outcome_matrix", "chart", "moderation",
        "mediation", "mechanism", "quote", "risk", "limitations", "future",
        "references"
      ]
    }
  }
}
