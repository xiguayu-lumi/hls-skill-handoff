{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "selected_angle_id", "slides"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "paper_id": {"type": "string"},
    "selected_angle_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "page_type", "communication_goal", "title", "lead",
          "content_blocks", "visual_plan", "evidence_ids", "risk_note"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "page_type": {"$ref": "#/$defs/page_type"},
          "communication_goal": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "lead": {"type": "string"},
          "content_blocks": {"type": "array"},
          "visual_plan": {"type": "object"},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^E[0-9]{3}$"}
          },
          "risk_note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "page_type": {
      "enum": [
        "cover", "paper_identity", "abstract_brief", "agenda", "section",
        "problem", "concept", "comparison", "method", "sample", "process",
        "finding", "metrics", "outcome_matrix", "chart", "moderation",
        "mediation", "mechanism", "quote", "risk", "limitations", "future",
        "references"
      ]
    }
  }
}
